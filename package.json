{
  "name": "@enhanced-dom/lint",
  "version": "0.4.2",
  "description": "Helpers for linting & git integration",
  "keywords": [],
  "repository": "https://github.com/enhanced-dom/lint.git",
  "license": "MIT",
  "author": "CD9B4A105290E17E0948E021DF4105107C88693C59C0B891CCC08366C51AEA990902A6A156AC87D88A2FC41422A5E1C3C4071F251F19441C4516000EC25F87DF",
  "type": "module",
  "main": "index.js",
  "bin": {
    "@enhanced-dom-husky": "./husky.js",
    "@enhanced-dom-fallow": "./fallow.js",
    "@enhanced-dom-npmrc": "./npmrc.js",
    "@enhanced-dom-nvmrc": "./nvmrc.js"
  },
  "scripts": {
    "configure-lint": "npm run build && node dist/fallow.js --gitignore --ignoreDependencies @babel/eslint-parser --ignoreDependencies stylelint-prettier --ignoreDependencies eslint-import-resolver-typescript --ignoreDependencies stylelint-config-recommended-scss && node dist/nvmrc.js --gitignore && node dist/npmrc.js --gitignore && node dist/husky.js --gitignore",
    "configure-claude": "@enhanced-dom-claude --configs react code agent rtk devcontainer caveman-lite",
    "prepare": "npm run configure-lint && npm run configure-claude",
    "prelint": "npm run build",
    "prebuild": "rimraf dist/*",
    "build": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "postbuild": "tsc-esm-fix --tsconfig=./tsconfig.json && copyfiles LICENSE.md README.md dist && @enhanced-dom-copy-packagejson",
    "package": "cd dist && npm pack",
    "lint": "eslint --fix --config eslint.config.mjs src && fallow && echo 'all ok'"
  },
  "dependencies": {
    "@babel/eslint-parser": "^8.0.6",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fallow": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@enhanced-dom/build": "^0.3.2",
    "@enhanced-dom/claude": "^0.3.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/lint-staged": "^14.0.0",
    "@types/node": "^22.20.4",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=12"
  }
}
